@startuml component_overview
!theme plain
title 𓆓 Wadjet-Link - Component Overview

skinparam componentStyle uml2
skinparam backgroundColor white
skinparam component {
    BackgroundColor<<core>> #E8F4FD
    BackgroundColor<<net>> #E8FDF4
    BackgroundColor<<pcap>> #FDF4E8
    BackgroundColor<<io>> #F4E8FD
    BackgroundColor<<protocol>> #FDE8E8
    BackgroundColor<<test>> #E8E8FD
    BackgroundColor<<scenario>> #FDF8E8
}

package "Wadjet-Link Library" {
    
    package "Core Layer" <<Rectangle>> {
        component [Types\n(MacAddress, IPv4Address)] as Types <<core>>
        component [Result<T,E>\nError Handling] as Result <<core>>
        component [Timestamp\nHigh Precision] as Timestamp <<core>>
        component [ByteOrder\nNetwork Utilities] as ByteOrder <<core>>
    }
    
    package "Network Layer" <<Rectangle>> {
        component [PacketView\nZero-Copy Parser] as PacketView <<net>>
        component [Packet\nMutable Buffer] as Packet <<net>>
    }
    
    package "File I/O Layer" <<Rectangle>> {
        component [PcapReader\nFile/Memory Source] as PcapReader <<pcap>>
        component [PcapWriter\nFile Output] as PcapWriter <<pcap>>
    }
    
    package "Live Capture Layer" <<Rectangle>> {
        component [CaptureSession\nAF_PACKET] as Capture <<io>>
        component [NetworkDevice\nEnumeration] as Device <<io>>
        component [FrameFilter\nBPF Compiler] as Filter <<io>>
    }
    
    package "Protocol Decoders" <<Rectangle>> {
        component [Ethernet\n(802.1Q/QinQ)] as Ethernet <<protocol>>
        component [IPv4\n(Checksum)] as IPv4 <<protocol>>
        component [UDP/TCP\n(Options)] as Transport <<protocol>>
        component [SOME/IP] as SOMEIP <<protocol>>
        component [SOME/IP-SD] as SOMEIPSD <<protocol>>
        component [DoIP] as DoIP <<protocol>>
        component [gPTP\n(IEEE 802.1AS)] as gPTP <<protocol>>
        component [UDS\n(ISO 14229)] as UDS <<protocol>>
        component [DDS/RTPS\n(OMG)] as DDS <<protocol>>
        component [ProtocolDispatcher\n(Stack Chaining)] as Dispatcher <<protocol>>
    }
}

package "Language Bindings" #E8FFE8 {
    component [C API\n(libwadjet_c)] as CBindings
    component [Python\n(pybind11)] as PyBindings
    component [Rust\n(wadjet-sys/wadjet)] as RustBindings
}

package "Scenario Module" #FDF8E8 {
    component [YAML Parser\nyaml-cpp] as YamlParser <<scenario>>
    component [JSON Parser\nnlohmann_json] as JsonParser <<scenario>>
    component [ScenarioRunner\nExecution Engine] as ScenarioRunner <<scenario>>
    component [ReportGenerators\n(JUnit, JSON, TAP, Text)] as Reports <<scenario>>
}

package "CLI Tools" {
    component [wadjet-run\nScenario Runner] as WadjetRun
}

package "External Dependencies" {
    component [libpcap] as libpcap
    component [Linux Kernel\nAF_PACKET] as Kernel
    component [GoogleTest] as GTest
    component [yaml-cpp] as YamlCpp
    component [nlohmann_json] as NlohmannJson
}

' Core dependencies
PacketView --> Types
PacketView --> ByteOrder
PacketView --> Timestamp
Packet --> PacketView
Packet --> Timestamp

' PCAP dependencies
PcapReader --> Packet
PcapReader --> Result
PcapWriter --> PacketView
PcapWriter --> Result

' I/O dependencies
Capture --> Packet
Capture --> Filter
Capture --> Device
Capture --> Result
Filter --> libpcap
Device --> Kernel
Capture --> Kernel

' Protocol dependencies
Ethernet --> PacketView : parses
IPv4 --> PacketView : parses
Transport --> PacketView : parses
SOMEIP --> PacketView : parses
SOMEIPSD --> SOMEIP : extends
DoIP --> PacketView : parses
gPTP --> PacketView : parses
UDS --> DoIP : uses
DDS --> PacketView : parses
Dispatcher --> Ethernet : chains
Dispatcher --> IPv4 : chains
Dispatcher --> Transport : chains
Dispatcher --> SOMEIP : chains
Dispatcher --> DoIP : chains
Dispatcher --> gPTP : chains
Dispatcher --> UDS : chains
Dispatcher --> DDS : chains

' Bindings dependencies
CBindings --> Dispatcher : wraps
CBindings --> Capture : wraps
CBindings --> PcapReader : wraps
CBindings --> PcapWriter : wraps
PyBindings --> CBindings : uses
RustBindings --> CBindings : FFI

' Scenario module dependencies
YamlParser --> YamlCpp : uses
JsonParser --> NlohmannJson : uses
ScenarioRunner --> Capture : captures
ScenarioRunner --> PcapReader : reads
ScenarioRunner --> PcapWriter : writes
ScenarioRunner --> Dispatcher : matches
WadjetRun --> YamlParser : parses
WadjetRun --> JsonParser : parses
WadjetRun --> ScenarioRunner : runs
WadjetRun --> Reports : generates

package "Test Framework" {
    component [Unit Tests\n(378 tests)] as UnitTests <<test>>
    component [Integration Tests\n(26 tests)] as IntegTests <<test>>
    component [Scenario Tests\n(41 tests)] as ScenarioTests <<test>>
    component [PacketBuilder\nHelper] as PktBuilder <<test>>
}

' Test dependencies
UnitTests --> GTest : uses
IntegTests --> GTest : uses
ScenarioTests --> GTest : uses
IntegTests --> Dispatcher : tests
IntegTests --> PcapReader : tests
IntegTests --> PcapWriter : tests
IntegTests --> Capture : tests
ScenarioTests --> ScenarioRunner : tests
ScenarioTests --> Reports : tests
PktBuilder --> ByteOrder : uses

note right of Kernel
  Requires:
  - CAP_NET_RAW capability
  - or root privileges
end note

note bottom of libpcap
  Used for:
  - BPF filter compilation
  - Not for capture (we use AF_PACKET)
end note

note bottom of IntegTests
  Live capture tests require
  CAP_NET_RAW or sudo
end note

@enduml
