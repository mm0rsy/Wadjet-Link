@startuml layer_architecture
!theme plain
title 𓆓 Wadjet-Link - Layered Architecture

skinparam backgroundColor white
skinparam rectangle {
    roundCorner 10
}

rectangle "**CLI Tools Layer**\n(wadjet-run)" as CLI #F8FDF8 {
    card "Scenario Runner CLI" as SRCLI
}

rectangle "**Test Layer**\n(GoogleTest)" as Test #E8E8FD {
    card "Unit Tests (378)" as UT
    card "Integration Tests (26)" as IT
    card "Scenario Tests (41)" as ST
    card "PacketBuilder" as PB
}

rectangle "**Scenario Layer**\n(YAML/JSON Scenarios)" as Scenario #FDF8E8 {
    card "ScenarioRunner" as SR
    card "YamlParser" as YP
    card "JsonParser" as JP
    card "ReportGenerators" as RG
    note "Milestone 4 ✅\nJUnit, JSON, TAP, Text" as N2
}

rectangle "**Application Layer**\n(User Code / Tests)" as App #F8F8FD {
}

rectangle "**Protocol Layer**\n(SOME/IP, DoIP, gPTP, UDS)" as Protocol #FDE8E8 {
    note "Milestone 2 ✅\nEthernet, IPv4, UDP, TCP,\nSOME/IP, DoIP" as N1
}

rectangle "**Packet Layer**\nPacketView | Packet" as Net #E8FDF4 {
    card "Zero-copy parsing" as ZC
    card "Header access" as HA
    card "Mutable buffers" as MB
}

rectangle "**I/O Layer**" as IO #F4E8FD {
    card "CaptureSession\n(Live AF_PACKET)" as CS
    card "PcapReader\n(File input)" as PR
    card "PcapWriter\n(File output)" as PW
    card "FrameFilter\n(BPF)" as FF
}

rectangle "**Core Layer**" as Core #E8F4FD {
    card "Types" as T
    card "Result<T,E>" as R
    card "Timestamp" as TS
    card "ByteOrder" as BO
}

rectangle "**System Layer**" as Sys #DDDDDD {
    card "Linux Kernel\nAF_PACKET" as K
    card "libpcap" as LP
    card "File System" as FS
    card "yaml-cpp" as YAML
    card "nlohmann_json" as JSON
}

CLI -down-> Scenario
Scenario -down-> Protocol
Scenario -down-> IO
Scenario -down-> Sys
Test -down-> App
Test -down-> Protocol
Test -down-> IO
Test -down-> Scenario
App -down-> Protocol
App -down-> Net
Protocol -down-> Net
Net -down-> IO
Net -down-> Core
IO -down-> Core
IO -down-> Sys
Core -down-> Sys

legend right
  | Color | Layer |
  | <#F8FDF8> | CLI |
  | <#E8E8FD> | Test |
  | <#FDF8E8> | Scenario |
  | <#F8F8FD> | Application |
  | <#FDE8E8> | Protocol |
  | <#E8FDF4> | Packet |
  | <#F4E8FD> | I/O |
  | <#E8F4FD> | Core |
  | <#DDDDDD> | System |
endlegend

@enduml
