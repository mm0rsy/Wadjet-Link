    package "Generators" #E8FDE8 {
        class Random {
            -rng_: mt19937_64
            -seed_: uint64_t
            --
            +Random(seed: uint64_t = 0)
            +seed(): uint64_t
            +reseed(seed: uint64_t): void
            +u8(): uint8_t
            +u16(): uint16_t
            +u32(): uint32_t
            +u64(): uint64_t
            +range(min, max): uint32_t
            +bytes(count): vector<byte>
            +mac_address(): MacAddress
            +ipv4_address(): IPv4Address
            +port(): uint16_t
        }
        
        class EthernetBuilder {
            -data_: vector<byte>
            -random_: Random*
            --
            +EthernetBuilder(random: Random&)
            +source(mac: MacAddress): this
            +destination(mac: MacAddress): this
            +ethertype(type: uint16_t): this
            +random_source(): this
            +random_destination(): this
            +build(): span<const byte>
        }
        
        class IPv4Builder {
            -data_: vector<byte>
            -random_: Random*
            --
            +IPv4Builder(random: Random&, ethernet: EthernetBuilder&)
            +source(ip: IPv4Address): this
            +destination(ip: IPv4Address): this
            +protocol(proto: uint8_t): this
            +ttl(ttl: uint8_t): this
            +random_source(): this
            +random_destination(): this
            +build(): span<const byte>
        }
        
        class UDPBuilder {
            -data_: vector<byte>
            -random_: Random*
            --
            +UDPBuilder(random: Random&, ipv4: IPv4Builder&)
            +source_port(port: uint16_t): this
            +dest_port(port: uint16_t): this
            +payload(data: span<const byte>): this
            +random_payload(size: size_t): this
            +build(): span<const byte>
        }
        
        class TCPBuilder {
            -data_: vector<byte>
            -random_: Random*
            --
            +TCPBuilder(random: Random&, ipv4: IPv4Builder&)
            +source_port(port: uint16_t): this
            +dest_port(port: uint16_t): this
            +seq(seq: uint32_t): this
            +ack(ack: uint32_t): this
            +flags(flags: uint8_t): this
            +payload(data: span<const byte>): this
            +build(): span<const byte>
        }
        
        class SOMEIPBuilder {
            -data_: vector<byte>
            -random_: Random*
            --
            +SOMEIPBuilder(random: Random&, udp: UDPBuilder&)
            +service_id(id: uint16_t): this
            +method_id(id: uint16_t): this
            +client_id(id: uint16_t): this
            +session_id(id: uint16_t): this
            +message_type(type: MessageType): this
            +return_code(code: ReturnCode): this
            +payload(data: span<const byte>): this
            +build(): span<const byte>
        }
        
        class DoIPBuilder {
            -data_: vector<byte>
            -random_: Random*
            --
            +DoIPBuilder(random: Random&, tcp: TCPBuilder&)
            +payload_type(type: PayloadType): this
            +logical_address(addr: uint16_t): this
            +target_address(addr: uint16_t): this
            +payload(data: span<const byte>): this
            +build(): span<const byte>
        }
        
        class PacketGenerator {
            -random_: Random
            --
            +PacketGenerator(seed: uint64_t = 0)
            +random(): Random&
            +ethernet(): EthernetBuilder
            +ipv4(): IPv4Builder
            +udp(): UDPBuilder
            +tcp(): TCPBuilder
            +someip(): SOMEIPBuilder
            +doip(): DoIPBuilder
        }
    }
    
    package "Record-Replay" #E8E8FD {
        class RecordedStream {
            -packets_: vector<Packet>
            --
            +RecordedStream(packets: vector<Packet>)
            +size(): size_t
            +empty(): bool
            +operator[](index): Packet&
            +begin(): iterator
            +end(): iterator
            +filter(predicate): RecordedStream
            +filter_matches(matcher): RecordedStream
            +slice(start, end): RecordedStream
            +skip(count): RecordedStream
            +take(count): RecordedStream
            +all_match(predicate): bool
            +filter_all_match(matcher): bool
            +any_matches(predicate): bool
            +filter_any_matches(matcher): bool
            +none_match(predicate): bool
            +count_matches(predicate): size_t
            +filter_count_matches(matcher): size_t
            +find_first(predicate): optional<Packet>
            +filter_find_first(matcher): optional<Packet>
            +has_sequence(predicates): bool
            +packets(): vector<Packet>&
            +save_to_pcap(path): void
            +{static} load_from_pcap(path): RecordedStream
        }
        
        class RecordSession {
            -packets_: vector<Packet>
            -session_: CaptureSession
            -running_: atomic<bool>
            --
            +RecordSession(interface: string, filter: string = "")
            +start(): void
            +stop(): RecordedStream
            +is_running(): bool
        }
    }
    
    package "Live-Assert" #FDF8E8 {
        enum AssertionRuleType {
            ASSERT_ALL
            ASSERT_NEVER
            ASSERT_WHEN
            EXPECT_WITHIN
        }
        
        class AssertionRule {
            +type: AssertionRuleType
            +predicate: function<bool(Packet)>
            +condition: function<bool(Packet)>
            +timeout: duration
            +description: string
            +satisfied: bool
            --
            +check(packet: Packet): bool
            +is_satisfied(): bool
            +reset_satisfied(): void
        }
        
        class ConditionalAssertionBuilder {
            -condition_: function<bool(Packet)>
            -session_: LiveAssertSession*
            --
            +ConditionalAssertionBuilder(session, condition)
            +assert_that(predicate): LiveAssertSession&
            +assert_matches(matcher): LiveAssertSession&
        }
        
        class LiveAssertSession {
            -rules_: vector<AssertionRule>
            -session_: CaptureSession
            -violations_: vector<Packet>
            -failure_dir_: path
            --
            +LiveAssertSession(interface: string, filter: string = "")
            +assert_all(predicate, desc): this
            +assert_all_match(matcher, desc): this
            +assert_never(predicate, desc): this
            +assert_never_match(matcher, desc): this
            +expect_within(predicate, timeout, desc): this
            +expect_within_match(matcher, timeout, desc): this
            +when(condition): ConditionalAssertionBuilder
            +set_failure_dir(dir): this
            +run_for(duration): bool
            +run_until(predicate, timeout): bool
            +violations(): vector<Packet>&
            +save_violations_pcap(path): void
        }
    }
}

