package "GoogleTest Framework" #EEEEEE {
    abstract class "::testing::Test" as GTestBase {
        #SetUp(): void
        #TearDown(): void
    }
    
    abstract class "::testing::PolymorphicMatcher" as GMockMatcher {
        +MatchAndExplain(): bool
        +DescribeTo(): void
    }
}

package "Wadjet Testing Framework" #FDE8E8 {
    
    struct LiveCaptureConfig {
        +interface: string
        +filter: string
        +save_on_failure: bool
        +failure_dir: path
        +max_stored_packets: size_t
    }
    
