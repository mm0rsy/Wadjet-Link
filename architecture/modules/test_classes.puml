        #session(): CaptureSession*
        #dispatcher(): ProtocolDispatcher&
        +wait_for_packet(predicate, timeout): optional<Packet>
        +wait_for_match(matcher, timeout): optional<Packet>
        +collect_packets(duration): vector<Packet>
        +collect_until(predicate, timeout): vector<Packet>
        +count_packets(predicate, duration): size_t
        +any_packet_matches(predicate, timeout): bool
        +stored_packets(): vector<Packet>&
