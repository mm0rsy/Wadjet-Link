# =============================================================================
# Doxyfile for Wadjet-Link
# 𓆓 Automotive Ethernet Validation Framework
# =============================================================================

# -----------------------------------------------------------------------------
# Project Information
# -----------------------------------------------------------------------------
PROJECT_NAME           = "Wadjet-Link"
PROJECT_NUMBER         = "0.1.0"
PROJECT_BRIEF          = "Automotive Ethernet Validation Framework"
PROJECT_LOGO           = 

# -----------------------------------------------------------------------------
# Input Configuration
# -----------------------------------------------------------------------------
INPUT                  = ../include/ \
                         ../src/ \
                         ./ \
                         ../README.md

INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.hpp *.cpp *.h *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */build/* */tests/* */.git/*

USE_MDFILE_AS_MAINPAGE = ../README.md

# -----------------------------------------------------------------------------
# Output Configuration
# -----------------------------------------------------------------------------
OUTPUT_DIRECTORY       = ./generated
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = YES
GENERATE_MAN           = NO

HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_COLORSTYLE        = LIGHT
HTML_DYNAMIC_SECTIONS  = YES
HTML_INDEX_NUM_ENTRIES = 100

# Modern HTML features
DISABLE_INDEX          = NO
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = NO
ENUM_VALUES_PER_LINE   = 1

# Search
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO

# -----------------------------------------------------------------------------
# Extraction Settings
# -----------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = YES
EXTRACT_ANON_NSPACES   = NO

HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = NO
HIDE_IN_BODY_DOCS      = NO

# -----------------------------------------------------------------------------
# Documentation Format
# -----------------------------------------------------------------------------
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MULTILINE_CPP_IS_BRIEF = NO

BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
ALWAYS_DETAILED_SEC    = NO

INLINE_INHERITED_MEMB  = YES
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = ../include ../src
SHORT_NAMES            = NO

# Namespaces
HIDE_SCOPE_NAMES       = NO
SHOW_INCLUDE_FILES     = YES
SHOW_GROUPED_MEMB_INC  = NO

# Sort options
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = NO
SORT_MEMBERS_CTORS_1ST = YES
SORT_GROUP_NAMES       = NO
SORT_BY_SCOPE_NAME     = NO

# -----------------------------------------------------------------------------
# Warnings
# -----------------------------------------------------------------------------
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_FORMAT            = "$file:$line: $text"

# -----------------------------------------------------------------------------
# Preprocessing
# -----------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = ../include

PREDEFINED             = DOXYGEN_SHOULD_SKIP_THIS \
                         __cplusplus=202002L

# -----------------------------------------------------------------------------
# Source Browsing
# -----------------------------------------------------------------------------
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES

VERBATIM_HEADERS       = YES

# -----------------------------------------------------------------------------
# Diagrams (if Graphviz/Dot available)
# -----------------------------------------------------------------------------
HAVE_DOT               = YES
DOT_NUM_THREADS        = 0

CLASS_DIAGRAMS         = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
UML_LOOK               = YES
UML_LIMIT_NUM_FIELDS   = 10
TEMPLATE_RELATIONS     = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO

DIRECTORY_GRAPH        = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
DOT_PATH               = 
DOT_GRAPH_MAX_NODES    = 100
MAX_DOT_GRAPH_DEPTH    = 0

# -----------------------------------------------------------------------------
# Aliases for common documentation patterns
# -----------------------------------------------------------------------------
ALIASES                = "threadsafe=\par Thread Safety:\n" \
                         "notthreadsafe=\par Thread Safety:\nNot thread-safe.\n" \
                         "automotive=\par Automotive:\n" \
                         "someip=\par SOME/IP:\n" \
                         "doip=\par DoIP:\n" \
                         "example=\par Example:\n"
